@page
@model AynısıEvde.Pages.recipe_listPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<body class="main-body1">
<div class="div-background-one">
<h4>edit recipe</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Recipe_list.recipe_id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Recipe_list.recipe_name" class="control-label"></label>
                <input asp-for="Recipe_list.recipe_name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Recipe_list.recipe_name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Recipe_list.recipe" class="control-label"></label>
                <input asp-for="Recipe_list.recipe" class="form-control" aria-required="true"/>
                <span asp-validation-for="Recipe_list.recipe" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Recipe_list.recipe_video" class="control-label"></label>
                <input asp-for="Recipe_list.recipe_video" class="form-control" />
                <span asp-validation-for="Recipe_list.recipe_video" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Recipe_list.user_id" class="control-label"></label>
                <input asp-for="Recipe_list.user_id" class="form-control" />
                <span asp-validation-for="Recipe_list.user_id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Recipe_list.approval" class="control-label"></label>
                <input asp-for="Recipe_list.approval" class="form-check-input" />
                <span asp-validation-for="Recipe_list.approval" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>
</div>
</body>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
