@page
@model AynısıEvde.Pages.FoodBlueprintModel
@{
	
}
<style>
    body {
        background-image: linear-gradient(rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.2)), url('/assets/Bg.png');
        background-repeat: repeat;
        background-size: auto;
        background-position: center;
        background-attachment: fixed;
        color: rgb(121, 67, 222);
    }

    
    html[data-bs-theme="light"] body {
        background-image: linear-gradient(rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.2)), url('/assets/Bg.png');
        background-repeat: repeat;
        background-size: auto;
        --metinco : rgb(121, 67, 222);
    }

    
    html[data-bs-theme="dark"] body {
        background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('/assets/Bg.png');
        background-repeat: repeat;
        background-size: auto;
        --metinco : rgb(255,255,255);
    }
    .dinamikMetin{
        color:var(--metinco);
    }
</style>
<body >
    <h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:60px; text-align:center;margin-top:100px">@Model.Name</h1>
    <div class="video-container" style="display: flex; justify-content: center; width: 100%; margin: 20px 0;margin-top:100px">
    <iframe width="560" 
            height="315" 
            src="https://youtube.com/embed/438dcMfDbBw?si=d-A0darJ2C9HkCq1" 
            title="YouTube video player" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen>
    ></iframe>
    
</div>
 <h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:18px; text-align:Center;margin-left:400px">@Model.User</h1>
<h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:30px; text-align:Center;">@Model.Name için gerekli Malzemeler:</h1>
        <div style="max-width: 500px; margin: 0 auto; text-align: left;">
        <h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:25px;">@Model.Ingredients<h1\>
</div>
<h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:30px; text-align:Center;margin-top:30px">@Model.Name Yapılışı:</h1>
<div style="max-width: 500px; margin: 0 auto; text-align: left;">
        <h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:25px;">@Model.description<h1\>
</div>
    </body>