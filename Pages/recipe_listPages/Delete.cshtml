@page
@model AynısıEvde.Pages.recipe_listPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}
<body class="main-body1">
<div class="div-background-one">
<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>AynısıEvde.model.Recipe_list</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
                    <!--DisplayNameFor alan adını DisplayFor alan içeriğini(burada recipe list elemanlarını) yazar   -->
            @Html.DisplayNameFor(model => model.Recipe_list.recipe_name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Recipe_list.recipe_name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Recipe_list.recipe)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Recipe_list.recipe)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Recipe_list.recipe_video)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Recipe_list.recipe_video)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Recipe_list.user_id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Recipe_list.user_id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Recipe_list.approval)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Recipe_list.approval)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Recipe_list.recipe_id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
</div>
</body>
