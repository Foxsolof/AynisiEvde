@{
    var currentTheme = Context.Request.Cookies["theme"] ?? "light";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AynısıEvde</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AynısıEvde.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">AynısıEvde</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            
                            <a class="nav-link " asp-area="" asp-page="/FoodBluePrint" asp-route-id="1">Tarif1+</a>
                           
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-page="/recipe_listPages/Index">Index</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-page="/Privacy">Privacy/GİZLİ</a>
                        </li>
                    </ul>
                    <form method="post" asp-page-handler="ToggleTheme" style="margin:0;">
                        <input type="hidden" name="id" id="currentRecipeId" value="" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            @(currentTheme == "light" ? "☀️ Aydınlık Mod" : "🌙 Karanlık Mod")
                        </button>
                    </form>
                    <form method="get" asp-page="./FoodBlueprint">
                        <div class="input-group">
                            <input type="number" name="id" class="form-control" placeholder="Yemek ID girin!(1,2..)" />
                            <button type="submit" class="btn btn-primary">Git</button>
                        </div>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AynısıEvde - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
                const urlParams = new URLSearchParams(window.location.search);
            const recipeId = urlParams.get('id');
            if (recipeId) {
                document.getElementById('currentRecipeId').value = recipeId;
            }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
