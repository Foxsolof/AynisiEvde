@page
@model AynısıEvde.Pages.recipe_listPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Recipe_list[0].recipe_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Recipe_list[0].recipe)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Recipe_list[0].recipe_video)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Recipe_list[0].user_id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Recipe_list[0].approval)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Recipe_list) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.recipe_name)
            </td>
            <td>
                @Html.DisplayFor(model => item.recipe)
            </td>
            <td>
                @Html.DisplayFor(model => item.recipe_video)
            </td>
            <td>
                @Html.DisplayFor(model => item.user_id)
            </td>
            <td>
                @Html.DisplayFor(model => item.approval)
            </td>
            <td>
                    <a asp-page="./Edit" asp-route-recipe_id="@item.recipe_id">Edit</a> |
                <a asp-page="./Details" asp-route-recipe_id="@item.recipe_id">Details</a> |
                    <a asp-page="./Delete" asp-route-recipe_id="@item.recipe_id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
