@page
@model AynısıEvde.Pages.FoodBlueprintModel
@{
	
}
<style>
 
    .dinamikMetin{
        color:var(--metinco);
        border: solid 2px black;
        border-radius:3px;
        width:fit-content;
        padding-left:20px;
        padding-right:20px;
        margin: auto;
        margin-top:20px;
        margin-bottom:20px;
        background-color: lightgray;
    }
    .dinamikKutu{
        border: solid var(--metinco) 5px;

    }
</style>
<body class="main-body1">
    <div class="main-container1">
    <h1 class="dinamikMetin" style="font-family:Arial,'Arial Rounded MT';font-size:60px; text-align:center;margin-top:100px">@Model.Name</h1>
    <div class="video-container" style="display: flex; justify-content: center; width: 100%; margin: 20px 0;margin-top:100px">
    <iframe width="560" 
            height="315" 
            src=@Model.videourl 
            title="YouTube video player" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen>
    ></iframe>
    
</div>
<div class="dinamikKutu" style="border-radius: 20px; max-width:550px;margin: 40px auto">
 <h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:18px; text-align:Center;margin: 30px 20px 40px 400px">@Model.User</h1>
<h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:30px; text-align:Center;">@Model.Name için gerekli Malzemeler:</h1>
        <div  style="max-width: 500px; margin: 0 auto; text-align: left;
    ">
        <h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:25px;">@Model.Ingredients<h1\>
</div>
<h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:30px; text-align:Center;margin-top:30px">@Model.Name Yapılışı:</h1>
<div style="max-width: 500px; margin: 0 auto; text-align: left;">
        <h1 class="dinamikMetin" style="white-space: pre-line;font-family:Arial,'Arial Rounded MT';font-size:25px;margin-bottom:30px">@Model.description<h1\>
</div>
</div>
            </div>
    </body>